# Copy this file to .env and fill in the values. Never commit .env.
#
# Model provider. The MVP runs Mistral through an OpenAI compatible endpoint.
# Moving to Bedrock is a base URL and a model string, nothing else.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Speech to text. Only needed for the audio evidence path. Text adjudication
# runs without it.
DEEPGRAM_API_KEY=

# Optional. Run and findings metadata. The engine works without these; the
# evidence log on disk is the source of truth either way.
SUPABASE_URL=
SUPABASE_KEY=
